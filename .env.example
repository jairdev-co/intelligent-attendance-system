# Copy to .env and fill in the real values (never commit .env)

# Required, generate it with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True only for local development (defaults to False)
DJANGO_DEBUG=True

# Trusted HTTPS origins for CSRF, comma-separated (production)
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection string (local SQLite when unset)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# On Railway these variables go in the service's Variables tab, not in .env:
#   DJANGO_SECRET_KEY, DJANGO_DEBUG=False and DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway sets RAILWAY_PUBLIC_DOMAIN by itself and the app adds it to the
# allowed hosts and CSRF origins.
